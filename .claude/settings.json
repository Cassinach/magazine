{
  "$comment": "routine（クラウドセッション、permission mode = dontAsk）向けの許可ルール。allow に無いものは自動拒否される。このファイルはローカルで Claude Code を使うときにも効くので、deny はローカル作業を妨げない最小限にしてある。ファイルパスや main の保護は .github/workflows/publish-gate.yml と GitHub の ruleset が担う。",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Write(issues/**)",
      "Edit(issues/**)",
      "Write(state/watchlist.json)",
      "Edit(state/watchlist.json)",
      "Write(.scratch/**)",
      "Edit(.scratch/**)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(node scripts/validate.mjs *)",
      "Bash(node scripts/build.mjs *)",
      "Bash(node scripts/fetch-figure.mjs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh api -X POST repos/Cassinach/magazine/pulls *)",
      "Bash(gh api repos/Cassinach/magazine/pulls *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr comment *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)"
    ]
  }
}
